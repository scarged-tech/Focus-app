# --- Supabase (obligatorio) ---
# Los tomas del panel de tu proyecto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo se usa en el servidor (webhook de WhatsApp). NUNCA la expongas al cliente.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Sitio (obligatorio para OAuth de Google) ---
# En local: http://localhost:3000  |  En producción: https://tu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar (opcional) ---
# Los obtienes en Google Cloud Console (ver README, sección Google Calendar)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Secreto para proteger el endpoint de sincronización automática (cron).
# Genera cualquier cadena aleatoria larga, ej. con: openssl rand -hex 32
CRON_SECRET=cambia-esto-por-algo-aleatorio-y-largo

# --- WhatsApp vía Twilio (opcional, solo si quieres esa integración) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- OpenAI (opcional, solo si quieres la integración de WhatsApp) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
